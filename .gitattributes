# Set default behaviour, in case users don't have core.autocrlf set.
* text=lf

# Explicitly declare text files we want to always be normalized and converted 
# to native line endings on checkout.
*.sh text

# Preserve generated IRV snapshots byte-for-byte and keep large data out of PR diffs.
experiments/irv_perturbation/artifacts/results/routes/*.jsonl -text -diff linguist-generated=true
experiments/irv_perturbation/artifacts/boundaries/NYC_862.txt -text -diff linguist-generated=true
experiments/irv_perturbation/artifacts/boundaries/*.geojson -text -diff linguist-generated=true
experiments/irv_perturbation/artifacts/results/final/*.csv text eol=lf linguist-generated=true
experiments/irv_perturbation/artifacts/results/final/*.png binary linguist-generated=true
